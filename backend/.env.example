# Spill Backend — Environment Variables
# Copy this file to .env and fill in your values

# Database (PostgreSQL with asyncpg)
SPILL_DATABASE_URL=postgresql+asyncpg://spill:your_password_here@localhost:5432/spill

# CORS Origins (JSON array of allowed frontend URLs)
SPILL_CORS_ORIGINS=["http://localhost:5173"]

# Application Mode
SPILL_DEBUG=true
SPILL_LOG_LEVEL=INFO

# Server
SPILL_HOST=0.0.0.0
SPILL_PORT=8000

# Maintenance / Kill Switch
SPILL_MAINTENANCE=false
SPILL_SUBMISSIONS_ENABLED=true

# Organization RSA Public Key (PEM format, for encryption verification)
SPILL_ORG_PUBLIC_KEY=

# Data Retention (days after resolution before auto-deletion)
SPILL_RETENTION_DAYS=365

# Admin Authentication (Two-Factor: Token + TOTP)
SPILL_ADMIN_TOKEN_HASH=
SPILL_ADMIN_TOTP_SECRET=
SPILL_ADMIN_SESSION_TTL=28800
SPILL_ADMIN_IDLE_TTL=1800
SPILL_ADMIN_MAX_ATTEMPTS=5
SPILL_ADMIN_LOCKOUT_SECONDS=900
