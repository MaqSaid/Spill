# Spill Backend — Environment Variables
# For judges: copy this file to .env → docker-compose up → ready to test
# cp .env.example .env

# Database (PostgreSQL with asyncpg)
SPILL_DATABASE_URL=postgresql+asyncpg://spill:spill_dev_password@localhost:5432/spill

# CORS Origins (JSON array of allowed frontend URLs)
SPILL_CORS_ORIGINS=["http://localhost:5173"]

# Application Mode
SPILL_DEBUG=true
SPILL_LOG_LEVEL=INFO

# Server
SPILL_HOST=0.0.0.0
SPILL_PORT=8000

# Maintenance / Kill Switch
SPILL_MAINTENANCE=false
SPILL_SUBMISSIONS_ENABLED=true

# Organization RSA Public Key (PEM format, single-line with \n escapes)
# This is the TEST public key matching keys/test_private_key.pem in the repo
